---
# Advisory only — deliberately NOT enforced in CI.
#
# tuix is formatted by hand: paired single-line if/else kept on aligned lines,
# `{ a, b }` init-list spacing, and wraps chosen for readability rather than
# for the column limit. clang-format cannot reproduce any of that, so running
# it across a whole file fights the surrounding style (~5.7k lines would move
# repo-wide). Use it on new code as a starting point, then adjust by hand.
BasedOnStyle: LLVM
Language: Cpp
Standard: c++17

IndentWidth: 4
TabWidth: 4
UseTab: Never
ColumnLimit: 110

PointerAlignment: Left
ReferenceAlignment: Left

AllowShortFunctionsOnASingleLine: Inline
AllowShortIfStatementsOnASingleLine: WithoutElse
AllowShortLoopsOnASingleLine: true
AllowShortCaseLabelsOnASingleLine: true

AlignConsecutiveAssignments:
  Enabled: true
  AcrossEmptyLines: false
  AcrossComments: false
AlignConsecutiveDeclarations:
  Enabled: true
  AcrossEmptyLines: false
  AcrossComments: false

BreakBeforeBraces: Attach
SpaceBeforeParens: ControlStatements

IncludeBlocks: Preserve
SortIncludes: false
